{
  "expo": {
    "name": "Neo Pen",
    "slug": "neopen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.francesco.neopen",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Neo Pen si collega alla tua Neo Smartpen per scaricare le pagine che scrivi, anche con l'app in background.",
        "UIBackgroundModes": [
          "bluetooth-central"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-calendar",
        {
          "calendarPermission": "NeoTransfer mostra e crea gli eventi dei tuoi calendari (Google, iCloud…) insieme alle attività del vault.",
          "remindersPermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Fra.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "52b223ed-59f2-4bf3-8f51-0f5f7a7fea4b"
      }
    }
  }
}
